# Cấu hình local — docker compose tự đọc file `.env` ở repo root.
# cp .env.example .env rồi sửa nếu cần. `.env` KHÔNG được commit (đã gitignore).

# Postgres
POSTGRES_USER=vulhunt
POSTGRES_PASSWORD=changeme
POSTGRES_DB=vulhunt
POSTGRES_PORT=5432

# Worker (FastAPI)
WORKER_PORT=8000

# Web (Next.js) — mặc định 3001 vì port 3000 bị process khác chiếm trên máy này
WEB_PORT=3001

# ─────────────────────────────────────────────────────────────
# Các key KHÔNG điền sẵn trong file này — điền vào `.env` thật.
# Agent sẽ DỪNG và hỏi qua chat khi ticket tương ứng cần key.

# (ticket #2) LLM provider cho hermes + key bearer nội bộ của API server hermes
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=            # phải khớp model.default trong config/hermes/config.yaml
# HERMES_API_SERVER_KEY=       # sinh bằng: openssl rand -hex 24 (chỉ dùng trong compose network)

# (ticket #11) key bearer của MCP endpoint /mcp trên worker — hermes gọi tool
# run_in_sandbox với header này. Sinh bằng: openssl rand -hex 24
# SANDBOX_MCP_KEY=

# (ticket #3) HackerOne Hacker API
# Auth = HTTP Basic <username>:<token> (không cần "API Token Identifier")
# HACKERONE_USERNAME=
# HACKERONE_API_TOKEN=

# (ticket #4) Intigriti Researcher API — Personal Access Token
# INTIGRITI_API_TOKEN=

# (ticket #6) username platform — dùng cho header định danh test traffic
# HACKERONE_USERNAME=          # (trùng giá trị trên)
# INTIGRITI_USERNAME=

# (ticket #9, tuỳ chọn) AlienVault OTX — cho waymore thu URL lịch sử
# OTX_API_KEY=
