# Cấu hình local — docker compose tự đọc file `.env` ở repo root.
# cp .env.example .env rồi sửa nếu cần. `.env` KHÔNG được commit (đã gitignore).

# Postgres
POSTGRES_USER=vulhunt
POSTGRES_PASSWORD=changeme
POSTGRES_DB=vulhunt
POSTGRES_PORT=5432

# Worker (FastAPI)
WORKER_PORT=8000

# Web (Next.js) — mặc định 3001 vì port 3000 bị process khác chiếm trên máy này
WEB_PORT=3001

# ─────────────────────────────────────────────────────────────
# Các key KHÔNG điền sẵn trong file này — điền vào `.env` thật.
# Agent sẽ DỪNG và hỏi qua chat khi ticket tương ứng cần key.

# (ticket #2) LLM provider cho hermes + key bearer nội bộ của API server hermes
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=            # phải khớp model.default trong config/hermes/config.yaml
# HERMES_API_SERVER_KEY=       # sinh bằng: openssl rand -hex 24 (chỉ dùng trong compose network)

# (ticket #11) key bearer của MCP endpoint /mcp trên worker — hermes gọi tool
# run_in_sandbox với header này. Sinh bằng: openssl rand -hex 24
# SANDBOX_MCP_KEY=

# (ticket #12) vòng xác minh open redirect: score ≥ ngưỡng → Candidate thành
# Finding (verified); dưới ngưỡng → rejected. Mặc định 0.85.
# VERIFY_CONFIDENCE_THRESHOLD=0.85
# URL canary mặc định làm payload PoC open redirect (khi không chỉ định).
# VERIFY_CANARY_URL=https://canary.example/vulhunt-poc

# (ticket #15, batch A) origin canary cho verify CORS misconfig — server KHÔNG
# được phép reflect origin này + cho credentials.
# VERIFY_CORS_ORIGIN=https://canary-vulhunt.example

# (ticket #13) interactsh OOB — KHÔNG cần key nào (dùng server public mặc
# định; client chạy trong worker, ADR-0004). Self-host interactsh là v2 khi
# lên VPS — khi đó hỏi lại về VPS/domain.
# Danh sách server public (phân tách phẩy) — worker chọn ngẫu nhiên 1 lúc register.
# INTERACTSH_SERVER=oast.pro,oast.live,oast.site,oast.online,oast.fun,oast.me
# Nhịp poll nền của worker (giây).
# OOB_POLL_INTERVAL_S=5
# Registration sống bao lâu (giờ) — đủ dài cho verify blind; hết hạn deregister sạch sẽ.
# OOB_REGISTRATION_TTL_H=24
# Callback cache giữ bao lâu (giờ) trước khi xoá khỏi DB.
# OOB_CALLBACK_RETENTION_H=168
# Cửa sổ chờ callback trong vòng xác minh OOB (giây) + nhịp poll từng lượt.
# OOB_VERIFY_WAIT_S=60
# OOB_VERIFY_POLL_S=5
# ⚠ Nếu mạng có thiết bị can thiệp TLS (FortiGate/corporate proxy) ký lại
# chứng chỉ oast.* bằng CA riêng: xuất root CA thành file PEM, mount vào
# container worker (thêm dòng sau vào service `worker` trong docker-compose.yml)
#   volumes:
#     - ./certs/fortinet-root.pem:/certs/ca.pem:ro
#   environment:
#     SSL_CERT_FILE: /certs/ca.pem
# (httpx của worker tự dùng SSL_CERT_FILE khi build SSL context mặc định)

# (ticket #14) subdomain takeover — hosting chứng minh kiểm soát cho PoC page.
# Bỏ trống = verify dừng ở "fingerprint match, cần xác minh tay" kèm hướng dẫn.
# 'github-pages' = deploy PoC qua GitHub API; 's3' = PutObject SigV4.
# TAKEOVER_HOSTING=
# Chỉ cần khi TAKEOVER_HOSTING=github-pages: token + account PHẢI trùng nhãn
# đầu của CNAME (*.github.io) — account lệch là không kiểm soát được.
# GITHUB_TOKEN=
# GITHUB_USERNAME=
# Chỉ cần khi TAKEOVER_HOSTING=s3: bucket claim tạo bằng PutObject (region
# mặc định us-east-1 — để khớp region của bản ghi CNAME treo).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# Cửa sổ chờ PoC page được phục vụ qua subdomain sau deploy (giây) + nhịp
# confirm probe — GitHub Pages build có thể mất vài phút.
# TAKEOVER_VERIFY_WAIT_S=120
# TAKEOVER_VERIFY_POLL_S=10

# (ticket #3) HackerOne Hacker API
# Auth = HTTP Basic <username>:<token> (không cần "API Token Identifier")
# HACKERONE_USERNAME=
# HACKERONE_API_TOKEN=

# (ticket #4) Intigriti Researcher API — Personal Access Token
# INTIGRITI_API_TOKEN=

# (ticket #6) username platform — dùng cho header định danh test traffic
# HACKERONE_USERNAME=          # (trùng giá trị trên)
# INTIGRITI_USERNAME=

# (ticket #9, tuỳ chọn) AlienVault OTX — cho waymore thu URL lịch sử
# OTX_API_KEY=

# ── catalog batch B (ticket #16) — exposed secrets + SQLi ──
# KHÔNG cần key nào: trufflehog verify-key gọi API provider công khai, sqlmap
# chạy trong sandbox với profile an toàn. Hai biến dưới chỉ là tinh chỉnh.
# SECRETS_MAX_TARGETS=25        # cap số URL nhạy cảm quét trufflehog mỗi Run
# SQLMAP_MIN_DELAY_S=1          # sàn delay giữa 2 request sqlmap (1 req/s)
