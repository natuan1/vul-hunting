# Cấu hình local — docker compose tự đọc file `.env` ở repo root.
# cp .env.example .env rồi sửa nếu cần. `.env` KHÔNG được commit (đã gitignore).

# Postgres
POSTGRES_USER=vulhunt
POSTGRES_PASSWORD=changeme
POSTGRES_DB=vulhunt
POSTGRES_PORT=5432

# Worker (FastAPI)
WORKER_PORT=8000

# Web (Next.js) — mặc định 3001 vì port 3000 bị process khác chiếm trên máy này
WEB_PORT=3001

# ─────────────────────────────────────────────────────────────
# Các key dưới đây KHÔNG điền sẵn — khi ticket tương ứng được làm,
# agent sẽ DỪNG và hỏi bạn cung cấp qua chat, rồi điền vào `.env`.

# (ticket #2) LLM provider cho hermes — khuyến nghị OpenRouter
# OPENROUTER_API_KEY=

# (ticket #3) HackerOne Hacker API — cặp token từ Account Settings → API Tokens
# HACKERONE_API_ID=
# HACKERONE_API_TOKEN=

# (ticket #4) Intigriti Researcher API — Personal Access Token
# INTIGRITI_PAT=

# (ticket #6) username platform — dùng cho header định danh test traffic
# HACKERONE_USERNAME=
# INTIGRITI_USERNAME=

# (ticket #9, tuỳ chọn) AlienVault OTX — cho waymore thu URL lịch sử
# OTX_API_KEY=
